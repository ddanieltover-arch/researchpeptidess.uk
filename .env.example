# =============================================================================
# Research Peptides UK — Production Environment Configuration (.env.example)
# Target: https://researchpeptidess.uk | Hosting: Vercel | Database: Neon PostgreSQL
# NOTE: Document variable names and structure only. Never commit secret values.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://researchpeptidess.uk"
NEXT_PUBLIC_APP_ENV="production" # "development" | "preview" | "production"
NEXT_PUBLIC_BRAND_NAME="Research Peptides UK"
STORE_STATUS="PRIVATE_BETA" # "MAINTENANCE" | "PRIVATE_BETA" | "LIVE"
NODE_ENV="production"

# -----------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE & DRIZZLE ORM
# -----------------------------------------------------------------------------
# Pooled connection string for serverless API routes (Neon PgBouncer / Connection Pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.eu-west-2.aws.neon.tech/research_peptides?sslmode=require"
# Direct unpooled connection string for migrations & DDL schema operations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample-direct.eu-west-2.aws.neon.tech/research_peptides?sslmode=require"

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# -----------------------------------------------------------------------------
AUTH_SECRET="your-64-character-cryptographically-secure-random-secret"
SESSION_SECRET="your-session-encryption-secret-string"
JWT_SIGNING_KEY="your-jwt-hmac-sha256-signing-key"
SESSION_EXPIRY_DAYS="14"

# -----------------------------------------------------------------------------
# 4. SECURE DOCUMENT & ASSET STORAGE (COAs, SDS, HPLC Files)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="s3-compatible" # "s3-compatible" | "vercel-blob" | "cloudflare-r2"
STORAGE_ENDPOINT="https://s3.eu-west-2.amazonaws.com"
STORAGE_BUCKET_DOCUMENTS="research-peptides-uk-coas"
STORAGE_BUCKET_IMAGES="research-peptides-uk-assets"
STORAGE_ACCESS_KEY_ID="your-storage-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-storage-secret-access-key"
STORAGE_PUBLIC_CDN_URL="https://cdn.researchpeptidess.uk"

# -----------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL PROVIDER (Order Confirmations, Invoices, Requisitions)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="resend" # "resend" | "postmark" | "sendgrid"
RESEND_API_KEY="re_sample_api_key_xxxxxxxx"
EMAIL_FROM_ADDRESS="orders@researchpeptidess.uk"
EMAIL_REPLY_TO="lab@researchpeptidess.uk"
EMAIL_SUPPORT_ADDRESS="support@researchpeptidess.uk"

# -----------------------------------------------------------------------------
# 6. PRIVACY-FIRST ANALYTICS & TELEMETRY
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_PROPERTY_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_ANALYTICS_CONSENT_REQUIRED="true"

# -----------------------------------------------------------------------------
# 7. ERROR MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
SENTRY_DSN="https://sample_key@o000000.ingest.sentry.io/0000000"
NEXT_PUBLIC_SENTRY_DSN="https://sample_key@o000000.ingest.sentry.io/0000000"
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"

# -----------------------------------------------------------------------------
# 8. PAYMENT RECONCILIATION & CRYPTOCURRENCY RECEIVING ADDRESSES
# -----------------------------------------------------------------------------
# UK Faster Payments & SEPA Bank Settlement (Public customer-facing instructions only)
BANK_TRANSFER_ACCOUNT_NAME="Research Peptides UK Ltd"
BANK_TRANSFER_BANK_NAME="Barclays Bank UK PLC"
BANK_TRANSFER_SORT_CODE="20-00-00"
BANK_TRANSFER_ACCOUNT_NUMBER="12345678"
BANK_TRANSFER_IBAN="GB29BARC20000012345678"
BANK_TRANSFER_BIC_SWIFT="BARCGB22"

# Public receiving cryptocurrency addresses (Public addresses only - NEVER private keys)
CRYPTO_DISCOUNT_PERCENTAGE="5"
CRYPTO_BTC_WALLET_ADDRESS="bc1q9v8084z65k90c7405g7620h5s9v65k8h8w3s92"
CRYPTO_ETH_WALLET_ADDRESS="0x71C9d004663AC2517C0AcFa669280dE4F2BE34cE"
CRYPTO_USDT_TRC20_WALLET_ADDRESS="TYD1B7mF3uVvQkR2X4k37d38z7nF3qLwN8"

# -----------------------------------------------------------------------------
# 9. VERCEL CRON & BACKGROUND WORKERS (Reservation Expiration Sweeps)
# -----------------------------------------------------------------------------
CRON_SECRET="your-vercel-cron-bearer-authorization-secret"

# -----------------------------------------------------------------------------
# 10. AI / SERVER-SIDE ACCELERATION (Optional)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
