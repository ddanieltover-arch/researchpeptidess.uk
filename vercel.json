{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": { "includeFiles": "src/**" },
    "api/ready.ts": { "includeFiles": "src/**" },
    "api/bootstrap.ts": { "includeFiles": "src/**" },
    "api/orders.ts": { "includeFiles": "src/**" },
    "api/orders/payment.ts": { "includeFiles": "src/**" },
    "api/contact.ts": { "includeFiles": "src/**" },
    "api/newsletter.ts": { "includeFiles": "src/**" },
    "api/inventory.ts": { "includeFiles": "src/**" },
    "api/admin/session.ts": { "includeFiles": "src/**" },
    "api/admin/[...path].ts": { "includeFiles": "src/**" },
    "api/account/[...path].ts": { "includeFiles": "src/**" }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|products/|hero/|favicon\\.svg|og-image\\.svg|robots\\.txt|sitemap\\.xml|logo\\.svg|index\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/product/bpc-157-reference-standard",
      "destination": "/product/bpc-157",
      "permanent": true
    },
