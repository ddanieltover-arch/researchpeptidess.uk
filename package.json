{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsx scripts/write-sitemap.ts && vite build && tsx scripts/prerender-html.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/lib/run-tests.ts",
    "db:migrate": "tsx scripts/apply-migrations.ts",
    "sync:woocommerce": "tsx scripts/woocommerce-sync/index.ts",
    "sync:woocommerce:dry": "tsx scripts/woocommerce-sync/index.ts --dry-run",
    "catalog:gap": "node scripts/catalog-gap-analysis.mjs",
    "catalog:import-gap": "tsx scripts/import-reference-gap.ts",
    "catalog:import-gap:dry": "tsx scripts/import-reference-gap.ts --dry-run",
    "catalog:import-supabase:dry": "tsx scripts/import-supabase-products-sql.ts --file \"%USERPROFILE%\\Downloads\\products_rows.sql\" --dry-run",
    "catalog:import-supabase": "tsx scripts/import-supabase-products-sql.ts --file \"%USERPROFILE%\\Downloads\\products_rows.sql\"",
    "catalog:dedupe": "tsx scripts/deduplicate-catalog-slugs.ts",
    "catalog:dedupe:dry": "tsx scripts/deduplicate-catalog-slugs.ts --dry-run",
    "db:push": "drizzle-kit push",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "sge:audit": "cd \"Search Growth Engineering Skill\" && python -m sge orchestrate --workspace research-peptides-uk --workspaces-root workspaces --mode audit",
    "sge:strategy": "cd \"Search Growth Engineering Skill\" && python -m sge orchestrate --workspace research-peptides-uk --workspaces-root workspaces --mode strategy"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "sharp": "^0.34.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "drizzle-kit": "^0.31.4"
  }
}
